{
  "schema_version": 1,
  "id": "install-guardian",
  "card": "install-guardian.md",
  "executor": {
    "kind": "driver",
    "path": "scripts/drivers/install-guardian.sh"
  },
  "execution_mode": "sandbox",
  "requires_hook": true,
  "surfaces": ["tools/install-hook.sh"],
  "requirements": ["doctor"],
  "cases": [
    {
      "id": "install-dry-run",
      "required_assertions": ["exit_0", "dry_run_no_write", "source_identity"]
    },
    {
      "id": "install-ownership",
      "required_assertions": ["ownership_marker", "dest_matches_source"]
    },
    {
      "id": "install-noop",
      "required_assertions": ["ya_al_dia", "dest_unchanged"]
    },
    {
      "id": "install-foreign",
      "required_assertions": ["foreign_intact"]
    },
    {
      "id": "install-restore",
      "required_assertions": ["restore_vendor_bytes"]
    }
  ]
}
