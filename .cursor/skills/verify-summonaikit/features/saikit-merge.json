{
  "schema_version": 1,
  "id": "saikit-merge",
  "card": "saikit-merge.md",
  "executor": {
    "kind": "driver",
    "path": "scripts/drivers/saikit-merge.sh"
  },
  "execution_mode": "simulated",
  "surfaces": ["tools/saikit-merge.sh", "tools/lib/coderabbit_gate.py"],
  "requirements": ["gh:simulated"],
  "cases": [
    {
      "id": "merge-listo",
      "required_assertions": ["listo_line", "no_merge_on_listo"]
    },
    {
      "id": "merge-confirmado",
      "required_assertions": [
        "merge_ok",
        "match_head",
        "no_admin",
        "no_delete_branch",
        "ci_revalidated",
        "recibo_consultado"
      ]
    },
    {
      "id": "merge-ci-rojo",
      "required_assertions": ["reject_ci_rojo", "no_merge_on_ci_rojo"]
    },
    {
      "id": "merge-base-movida",
      "required_assertions": ["reject_base_avanzada", "no_merge_on_base"]
    },
    {
      "id": "merge-recibo-ajeno",
      "required_assertions": ["reject_recibo_ajeno", "no_merge_on_recibo"]
    },
    {
      "id": "merge-recibo-revocado",
      "required_assertions": ["reject_recibo_revocado", "no_merge_on_revocado"]
    },
    {
      "id": "revert-ok",
      "required_assertions": ["revert_merge_ok", "revert_match_head"]
    },
    {
      "id": "revert-sin-trailer",
      "required_assertions": ["reject_sin_trailer", "no_merge_on_trailer"]
    },
    {
      "id": "revert-no-punta",
      "required_assertions": ["reject_no_punta", "no_merge_on_punta"]
    },
    {
      "id": "merge-lock-contencion",
      "required_assertions": ["lock_exit_3", "lock_reporta_hint", "no_merge_on_lock"]
    },
    {
      "id": "merge-lock-propio",
      "required_assertions": ["lock_ajeno_sobrevive", "lock_propio_liberado"]
    },
    {
      "id": "merge-lock-worktrees",
      "required_assertions": ["lock_comun_worktrees", "no_merge_on_lock_wt"]
    },
    {
      "id": "merge-lock-recuperacion",
      "required_assertions": ["liberar_quita_y_muestra", "liberar_sin_lock_verde"]
    }
  ]
}
