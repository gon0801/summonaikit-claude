{
  "schema_version": 1,
  "id": "check-deploy-log",
  "card": "check-deploy-log.md",
  "executor": {
    "kind": "driver",
    "path": "scripts/drivers/check-deploy-log.sh"
  },
  "execution_mode": "sandbox",
  "surfaces": ["tools/check-deploy-log.sh"],
  "requirements": ["docs/deploy-log.md"],
  "cases": [
    {
      "id": "deploy-log-ok",
      "required_assertions": ["exit_0", "deploy_log_ok_line"]
    },
    {
      "id": "deploy-log-order",
      "required_assertions": ["exit_nonzero", "reason_orden"]
    },
    {
      "id": "deploy-log-dup",
      "required_assertions": ["exit_nonzero", "reason_dup_pr"]
    },
    {
      "id": "deploy-log-hora-evidente",
      "required_assertions": ["hora_evidente_aceptado"]
    },
    {
      "id": "deploy-log-hora-no-recuperada",
      "required_assertions": ["hora_no_recuperada_aceptado"]
    },
    {
      "id": "deploy-log-hora-sin-evidencia",
      "required_assertions": ["hora_sin_evidencia_rechazado", "reason_evidencia"]
    }
  ]
}
