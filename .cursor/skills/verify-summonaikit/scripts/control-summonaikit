#!/usr/bin/env bash
# control-summonaikit — helpers for the verify-summonaikit skill.
# Isolates every write behind a disposable run. State is .run/state.json
# (validated data). Never sources .run/env. Never evals state.
set -euo pipefail

skill_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# .cursor/skills/verify-summonaikit -> repo root
repo="$(cd "$skill_root/../../.." && pwd)"

STATE_DIR="${SAIKIT_VERIFY_STATE:-$skill_root/.run}"
ARTIFACTS="${SAIKIT_VERIFY_ARTIFACTS:-$skill_root/artifacts}"
HOOK_SRC="$repo/hooks/summonaikit-harness.sh"
MANIFEST="$repo/hooks/vendor-manifest.sha256"
INSTALLER="$repo/tools/install-hook.sh"
STATEPY="$skill_root/scripts/lib/state.py"
EVIDPY="$skill_root/scripts/lib/evidence.py"
CATALOG="$skill_root/features/catalog.json"

# Avoid writing __pycache__ under the versioned skill tree (inventory lint).
export PYTHONDONTWRITEBYTECODE=1

# shellcheck source=lib/runtime.sh
. "$skill_root/scripts/lib/runtime.sh"

die() { printf 'control-summonaikit: %s\n' "$*" >&2; exit 2; }
need_cmd() { command -v "$1" >/dev/null 2>&1 || die "missing command: $1"; }

evidence() {
  [ -f "$EVIDPY" ] || die "missing $EVIDPY"
  PYTHONDONTWRITEBYTECODE=1 python3 "$EVIDPY" "$@"
}

_parse_kv() {
  printf '%s\n' "$2" | sed -n "s/^${1}=//p" | head -1
}

_feature_status() {
  python3 - "$CATALOG" "$1" <<'PY'
import json, sys
cat = json.loads(open(sys.argv[1], encoding="utf-8").read())
fid = sys.argv[2]
meta = (cat.get("features") or {}).get(fid)
if not meta:
    print("missing")
else:
    print(meta.get("status") or "active")
PY
}

_cases_and_assertions() {
  # stdout: CASES=... then REQS=... (space-separated)
  # optional extra args: restrict to those case ids
  python3 - "$skill_root/features/$1.json" "${@:2}" <<'PY'
import json, sys
from pathlib import Path
p = Path(sys.argv[1])
want = [a for a in sys.argv[2:] if a]
if not p.is_file():
    print("CASES=")
    print("REQS=")
    raise SystemExit(0)
d = json.loads(p.read_text(encoding="utf-8"))
cases = []
reqs = []
for c in d.get("cases") or []:
    cid = c.get("id") or ""
    if want and cid not in want:
        continue
    cases.append(cid)
    reqs.extend(c.get("required_assertions") or [])
print("CASES=" + " ".join(cases))
print("REQS=" + " ".join(reqs))
PY
}

_driver_script() {
  if [ -n "${SAIKIT_FM_DRIVER:-}" ] && [ -f "${SAIKIT_FM_DRIVER}" ]; then
    printf '%s' "$SAIKIT_FM_DRIVER"
    return
  fi
  python3 - "$skill_root/features/$1.json" "$skill_root" <<'PY'
import json, sys
from pathlib import Path
p = Path(sys.argv[1])
skill = Path(sys.argv[2])
if not p.is_file():
    raise SystemExit(0)
d = json.loads(p.read_text(encoding="utf-8"))
ex = d.get("executor") or {}
path = ex.get("path") or f"scripts/drivers/{d.get('id')}.sh"
print(skill / path)
PY
}

_dispatch_driver() {
  local fid="$1" scope="$2" only="${3:-}"
  local meta cases reqs
  if [ -n "$only" ]; then
    meta="$(_cases_and_assertions "$fid" "$only")"
  else
    meta="$(_cases_and_assertions "$fid")"
  fi
  cases="$(_parse_kv CASES "$meta")"
  reqs="$(_parse_kv REQS "$meta")"
  local created adir driver
  created="$(begin_attempt "$fid" "$cases" "$reqs" "$scope")"
  adir="$(_parse_kv ATTEMPT_DIR "$created")"
  [ -d "$adir" ] || iso_fail "no se pudo crear intento de evidencia"
  driver="$(_driver_script "$fid")"
  if [ ! -f "$driver" ]; then
    write_blocked_attempt "$fid" "sin driver"
  fi
  set +e
  SAIKIT_FM_ATTEMPT_DIR="$adir" \
  SAIKIT_FM_FEATURE="$fid" \
  SAIKIT_FM_SCOPE="$scope" \
  SAIKIT_FM_ONLY_CASE="$only" \
  SAIKIT_FM_EVIDENCE="$EVIDPY" \
    bash "$driver"
  set -e
  set +e
  finish_attempt "$adir" "$reqs" "$scope"
  local ec=$?
  set -e
  exit "$ec"
}

_gate_case_for_scenario() {
  case "$1" in
    01-sin-armar) printf '%s' "gate-unarmed" ;;
    02-armado-contrato) printf '%s' "gate-armed" ;;
    07-evidencia-incompleta) printf '%s' "gate-stop-no-receipt" ;;
    *) printf '%s' "$1" ;;
  esac
}

_evidence_run_id() {
  if [ "${SAIKIT_VERIFY_MUTATE:-}" = reuse_attempt_id ]; then
    printf 'reused-run'
    return
  fi
  if [ -n "${VERIFY_RUN_ID:-}" ]; then
    printf '%s' "$VERIFY_RUN_ID"
    return
  fi
  printf 'synth-%s-%s' "$(date -u +%Y%m%dT%H%M%SZ)" "$$"
}

begin_attempt() {
  local fid="$1" cases="$2" reqs="$3" scope="${4:-full}"
  local extra=""
  if [ "$scope" = partial ]; then
    extra="--scope partial --scope-partial"
  fi
  # shellcheck disable=SC2086
  evidence create-attempt \
    --artifacts "$ARTIFACTS" \
    --run-id "$(_evidence_run_id)" \
    --feature-id "$fid" \
    --repo "$repo" \
    --mode sandbox \
    --cases "$cases" \
    --required-assertions "$reqs" \
    $extra
}

append_action() {
  local adir="$1" case_id="$2" step="$3" tool_exit="$4" observation="$5"
  shift 5 || true
  evidence append-step --attempt-dir "$adir" --type action \
    --case-id "$case_id" --step-id "$step" \
    --tool-exit "$tool_exit" --observation "$observation" \
    --command "$*"
}

append_assertion() {
  local adir="$1" case_id="$2" asid="$3" result="$4" expected="$5" observed="$6"
  evidence append-step --attempt-dir "$adir" --type assertion \
    --case-id "$case_id" --step-id "s-$asid" --assertion-id "$asid" \
    --expected "$expected" --observed "$observed" --result "$result"
}

finish_attempt() {
  local adir="$1" reqs="$2" scope="${3:-}"
  local extra=""
  if [ "$scope" = partial ]; then
    extra="--scope partial --scope-partial"
    printf 'alcance parcial (scope=partial)\n'
  fi
  # shellcheck disable=SC2086
  evidence finalize --attempt-dir "$adir" --required-assertions "$reqs" $extra
}

record_case_assertions() {
  # $1=adir $2=case $3=result $4=observed-note; rest=assertion ids
  local adir="$1" case_id="$2" result="$3" note="$4"
  shift 4
  local a
  for a in "$@"; do
    [ -n "$a" ] || continue
    append_assertion "$adir" "$case_id" "$a" "$result" "$a" "$note"
  done
}

run_synthetic_drive() {
  local fid="$1" cases="$2" reqs="$3" scope="${4:-full}"
  local kind="${SAIKIT_VERIFY_SYNTHETIC_EXECUTOR:-}"
  [ -n "$kind" ] || return 0
  mkdir -p "$ARTIFACTS"
  local created adir result_kind tool_exit note
  created="$(begin_attempt "$fid" "$cases" "$reqs" "$scope")" || return 1
  adir="$(_parse_kv ATTEMPT_DIR "$created")"
  [ -d "$adir" ] || return 1
  case "$kind" in
    PASS|pass)
      result_kind=PASS; tool_exit=0; note=synthetic-pass
      ;;
    FAIL|fail)
      result_kind=FAIL; tool_exit=1; note=synthetic-fail
      ;;
    unknown|UNKNOWN)
      result_kind=unknown; tool_exit=""; note=synthetic-unknown
      ;;
    *)
      result_kind=unknown; tool_exit=""; note="synthetic-blocked"
      ;;
  esac
  local first_case="${cases%% *}"
  append_action "$adir" "$first_case" "act-synth" "$tool_exit" "$note" "synthetic" "$kind"
  # shellcheck disable=SC2086
  record_case_assertions "$adir" "$first_case" "$result_kind" "$note" $reqs
  set +e
  finish_attempt "$adir" "$reqs" "$scope"
  local ec=$?
  set -e
  printf 'synthetic=%s feature=%s scope=%s\n' "$kind" "$fid" "$scope"
  exit "$ec"
}

write_blocked_attempt() {
  local fid="$1" reason="$2"
  mkdir -p "$ARTIFACTS"
  local created adir
  created="$(begin_attempt "$fid" "" "" full)" || {
    printf 'control-summonaikit: BLOCKED %s — %s\n' "$fid" "$reason"
    exit 3
  }
  adir="$(_parse_kv ATTEMPT_DIR "$created")"
  if [ -d "$adir" ]; then
    evidence append-step --attempt-dir "$adir" --type diagnostic \
      --case-id "" --step-id blocked --observation "$reason" --tool-exit "" \
      >/dev/null || true
    evidence append-step --attempt-dir "$adir" --type assertion \
      --case-id "" --step-id s-blocked --assertion-id availability \
      --expected runnable --observed "BLOCKED $reason" --result unknown \
      >/dev/null || true
    set +e
    evidence finalize --attempt-dir "$adir" --required-assertions availability >/dev/null
    set -e
  fi
  printf 'control-summonaikit: BLOCKED %s — %s (unknown)\n' "$fid" "$reason"
  exit 3
}

load_state() {
  local mode="${1:-drive}"
  [ -f "$STATEPY" ] || die "missing $STATEPY"
  runtime_load "$mode"
}

cmd_launch() {
  need_cmd bash
  need_cmd mktemp
  need_cmd python3
  [ -f "$HOOK_SRC" ] || die "hook source missing: $HOOK_SRC"
  [ -f "$INSTALLER" ] || die "installer missing: $INSTALLER"
  [ -f "$STATEPY" ] || die "missing $STATEPY"

  runtime_preflight_launch
  umask 077
  mkdir -p "$STATE_DIR" "$ARTIFACTS"
  if ! mkdir "$STATE_DIR/.active" 2>/dev/null; then
    iso_fail "run activo — run cleanup first"
  fi

  run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  token="$(python3 -c 'import secrets; print(secrets.token_hex(16))')"
  verify_home="$(mktemp -d "${TMPDIR:-/tmp}/saikit-verify-${run_id}-XXXXXX")"
  run_tmp="$verify_home/tmp"
  mkdir -p "$verify_home/.claude/hooks" \
    "$verify_home/.grok/hooks" \
    "$verify_home/.dsh/hooks" \
    "$verify_home/.codex/hooks" \
    "$verify_home/git" \
    "$run_tmp"
  runtime_write_marker "$verify_home" "$run_id" "$token"

  dest="$verify_home/.claude/hooks/summonaikit-harness.sh"
  disposable=""
  git_common=""
  if command -v git >/dev/null 2>&1; then
    if (
      VERIFY_HOME="$verify_home"
      VERIFY_TMPDIR="$run_tmp"
      runtime_exec "$verify_home" git init --bare "$verify_home/git/origin.git" >/dev/null \
        && runtime_exec "$verify_home" git init "$verify_home/git/work" >/dev/null
    ); then
      disposable="$verify_home/git/work"
      git_common="$verify_home/git/work/.git"
    fi
  fi

  VERIFY_HOME="$verify_home"
  VERIFY_TMPDIR="$run_tmp"
  out="$ARTIFACTS/launch-${run_id}.txt"
  mkdir -p "$ARTIFACTS"
  set +e
  runtime_exec "$verify_home" bash "$INSTALLER" \
    --dest "$dest" --source "$HOOK_SRC" --manifest "$MANIFEST" \
    >"$out" 2>&1
  rc=$?
  set -e
  if [ "$rc" -ne 0 ]; then
    cat "$out" >&2
    rm -rf "$verify_home"
    runtime_clear_state_files
    iso_fail "install failed (exit $rc); see $out"
  fi

  payload="$(mktemp "${TMPDIR:-/tmp}/saikit-state-XXXXXX.json")"
  python3 - "$payload" <<PY
import json, sys
from datetime import datetime, timezone
path = sys.argv[1]
data = {
    "schema_version": 1,
    "run_id": "$run_id",
    "launched_at": datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ"),
    "repo": "$repo",
    "verify_home": "$verify_home",
    "dest": "$dest",
    "state_dir": "$STATE_DIR",
    "artifacts_dir": "$ARTIFACTS",
    "tmpdir": "$run_tmp",
    "owned_temps": ["$verify_home", "$run_tmp"],
    "host_dests": {
        "claude": "$dest",
        "grok": "$verify_home/.grok/hooks/summonaikit-harness.sh",
        "dsh": "$verify_home/.dsh/hooks/summonaikit-harness.sh",
        "codex": "$verify_home/.codex/hooks/summonaikit-harness.sh",
    },
    "git_common_dir": "$git_common",
    "disposable_repo": "$disposable",
    "token": "$token",
}
with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f)
    f.write("\n")
PY
  runtime_save_state "$payload"
  rm -f "$payload"

  printf 'launched run_id=%s\nVERIFY_HOME=%s\nDEST=%s\nlog=%s\n' \
    "$run_id" "$verify_home" "$dest" "$out"
}

cmd_doctor() {
  need_cmd bash
  need_cmd python3
  [ -f "$HOOK_SRC" ] || die "hook source missing: $HOOK_SRC"
  [ -f "$INSTALLER" ] || die "installer missing: $INSTALLER"
  [ -f "$repo/tools/audita-ledger.sh" ] || die "audita-ledger.sh missing"
  [ -f "$repo/tools/check-deploy-log.sh" ] || die "check-deploy-log.sh missing"
  [ -f "$repo/tools/golden-harness.sh" ] || die "golden-harness.sh missing"

  load_state doctor

  fail=0
  printf 'doctor: VERIFY_HOME=%s\n' "$VERIFY_HOME"
  printf 'doctor: DEST=%s\n' "$VERIFY_DEST"

  if [ ! -f "$VERIFY_DEST" ]; then
    printf 'doctor: FAIL — hook not installed at DEST\n'
    fail=1
  else
    if head -n 2 "$VERIFY_DEST" | grep -q 'SAIKIT-CLAUDE-OWNED'; then
      printf 'doctor: OK — ownership marker present\n'
    else
      printf 'doctor: FAIL — ownership marker missing\n'
      fail=1
    fi
    if bash -n "$VERIFY_DEST" 2>/dev/null; then
      printf 'doctor: OK — bash -n clean\n'
    else
      printf 'doctor: FAIL — bash -n failed\n'
      fail=1
    fi
    src_sha="$(sha256sum < "$HOOK_SRC" | cut -d' ' -f1)"
    dst_sha="$(sha256sum < "$VERIFY_DEST" | cut -d' ' -f1)"
    if [ "$src_sha" = "$dst_sha" ]; then
      printf 'doctor: OK — DEST matches repo source (%s)\n' "${src_sha:0:12}"
    else
      printf 'doctor: FAIL — DEST sha %s != source %s\n' "${dst_sha:0:12}" "${src_sha:0:12}"
      fail=1
    fi
  fi

  case "$VERIFY_DEST" in
    "$VERIFY_HOME"/*) printf 'doctor: OK — DEST is under VERIFY_HOME\n' ;;
    *)
      printf 'doctor: FAIL — DEST is not under VERIFY_HOME\n'
      fail=1
      ;;
  esac

  if [ "$fail" -ne 0 ]; then
    printf 'doctor: FAIL\n'
    exit 1
  fi
  printf 'doctor: PASS\n'
}

cmd_cleanup() {
  need_cmd python3
  [ -f "$STATEPY" ] || die "missing $STATEPY"
  if [ -f "$STATE_DIR/env" ]; then
    iso_fail "legacy .run/env — re-lanzar: borrar solo el archivo env (nunca su HOME) y correr launch"
  fi
  if [ ! -f "$STATE_DIR/state.json" ]; then
    printf 'cleanup: nothing to do (no active instance)\n'
    runtime_clear_state_files
    printf 'cleanup: instance cleared (artifacts kept under %s)\n' "$ARTIFACTS"
    exit 0
  fi
  # Load must not trap the operator: invalid JSON, missing VERIFY_HOME, or
  # foreign ownership ⇒ soft-clear state/.active only (never rm an unverified HOME).
  # Spec: repeating cleanup is inocuous; recovery mirrors legacy .run/env.
  err="$(mktemp "${TMPDIR:-/tmp}/saikit-cleanup-err-XXXXXX")"
  if _STATE_JSON="$(
    python3 "$STATEPY" load \
      --state-dir "$STATE_DIR" \
      --artifacts "$ARTIFACTS" \
      --repo "$repo" \
      --mode cleanup \
      --mutate "$(runtime_mutate)" 2>"$err"
  )"; then
    rm -f "$err"
    VERIFY_HOME="$(runtime_json_get verify_home)"
    runtime_cleanup_home "$VERIFY_HOME"
    runtime_clear_state_files
    printf 'cleanup: instance cleared (artifacts kept under %s)\n' "$ARTIFACTS"
    exit 0
  fi
  reason="$(cat "$err" 2>/dev/null || true)"
  rm -f "$err"
  runtime_clear_state_files
  printf 'cleanup: estado no recuperable — state.json/.active borrados; HOME no tocado\n'
  if [ -n "$reason" ]; then
    printf 'cleanup: motivo: %s\n' "$reason"
  fi
  printf 'cleanup: re-lanzar con launch (nunca borres un HOME a ciegas)\n'
  printf 'cleanup: instance cleared (artifacts kept under %s)\n' "$ARTIFACTS"
  exit 0
}

cmd_cli() {
  need_cmd python3
  load_state cli
  [ "$#" -ge 1 ] || die "usage: control-summonaikit cli -- <catalog-entry...>"
  if [ "$1" = "--" ]; then shift; fi
  [ "$#" -ge 1 ] || die "usage: control-summonaikit cli -- <catalog-entry...>"
  tool="$(runtime_cli_ok "$@")" || exit 1
  shift
  runtime_exec "$VERIFY_HOME" bash "$VERIFY_REPO/$tool" "$@"
}

cmd_drive_install_dry_run() {
  local meta cases reqs
  meta="$(_cases_and_assertions install-guardian install-dry-run)"
  cases="$(_parse_kv CASES "$meta")"
  reqs="$(_parse_kv REQS "$meta")"
  run_synthetic_drive install-guardian "$cases" "$reqs" partial
  load_state drive
  _dispatch_driver install-guardian partial install-dry-run
}

cmd_drive_gate_scenario() {
  local scenario="${1:-01-sin-armar}"
  local case_id meta cases reqs
  case_id="$(_gate_case_for_scenario "$scenario")"
  meta="$(_cases_and_assertions gate-turn "$case_id")"
  cases="$(_parse_kv CASES "$meta")"
  reqs="$(_parse_kv REQS "$meta")"
  run_synthetic_drive gate-turn "$cases" "$reqs" partial
  load_state drive
  local src="$VERIFY_REPO/tests/fixtures/escenarios/$scenario"
  [ -d "$src" ] || iso_fail "unknown scenario: $scenario"
  printf 'alcance parcial: alias drive-gate-scenario acredita solo %s\n' "$case_id"
  _dispatch_driver gate-turn partial "$case_id"
}

cmd_drive_audit_ledger() {
  local meta cases reqs
  meta="$(_cases_and_assertions audit-ledger)"
  cases="$(_parse_kv CASES "$meta")"
  reqs="$(_parse_kv REQS "$meta")"
  run_synthetic_drive audit-ledger "$cases" "$reqs" full
  load_state drive
  _dispatch_driver audit-ledger full
}

cmd_drive_deploy_log() {
  local meta cases reqs
  meta="$(_cases_and_assertions check-deploy-log)"
  cases="$(_parse_kv CASES "$meta")"
  reqs="$(_parse_kv REQS "$meta")"
  run_synthetic_drive check-deploy-log "$cases" "$reqs" full
  load_state drive
  _dispatch_driver check-deploy-log full
}

cmd_list_features() {
  python3 - "$CATALOG" "$skill_root" <<'PY'
import json, sys
from pathlib import Path

cat = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
skill = Path(sys.argv[2])
for fid, meta in (cat.get("features") or {}).items():
    status = meta.get("status") or "active"
    card = meta.get("card") or ""
    mode = ""
    scope = "none"
    owner = meta.get("owner_task") or ""
    desc = skill / "features" / f"{fid}.json"
    if desc.is_file():
        d = json.loads(desc.read_text(encoding="utf-8"))
        mode = d.get("execution_mode") or ""
        cases = [c.get("id") for c in (d.get("cases") or []) if c.get("id")]
        scope = "full"
        if cases:
            scope = "full cases=" + ",".join(cases)
    line = f"id={fid} card={card} mode={mode} scope={scope} status={status}"
    if owner:
        line += f" owner_task={owner}"
    print(line)
PY
}

cmd_drive() {
  local fid="${1:-}"
  [ -n "$fid" ] || die "usage: control-summonaikit drive <id>"
  local status
  status="$(_feature_status "$fid")"
  if [ "$status" = missing ]; then
    write_blocked_attempt "$fid" "feature desconocida"
  fi
  if [ "$status" = pending ]; then
    write_blocked_attempt "$fid" "pending sin ejecutor"
  fi
  if [ ! -f "$skill_root/features/$fid.json" ]; then
    write_blocked_attempt "$fid" "sin descriptor"
  fi
  local meta cases reqs
  meta="$(_cases_and_assertions "$fid")"
  cases="$(_parse_kv CASES "$meta")"
  reqs="$(_parse_kv REQS "$meta")"
  if [ -n "${SAIKIT_VERIFY_SYNTHETIC_EXECUTOR:-}" ]; then
    run_synthetic_drive "$fid" "$cases" "$reqs" full
  fi
  if [ ! -f "$STATE_DIR/state.json" ]; then
    write_blocked_attempt "$fid" "sin instancia — doctor/launch faltante"
  fi
  load_state drive
  _dispatch_driver "$fid" full
}

usage() {
  cat <<'EOF'
usage: control-summonaikit <command> [args]

commands:
  launch                         create isolated HOME and install the hook there
  doctor                         read-only health check of the active instance
  cleanup                        remove owned temps; keep artifacts/
  cli -- <catalog-entry...>      run a catalog public entry under the run env
                                 (not an arbitrary shell/command; deliberate
                                 restriction vs the old CLI)
  list-features                  enumerate id/card/mode/scope (no launch)
  drive <id>                     run all required cases for that feature
  drive-install-dry-run          exercise installer --dry-run under VERIFY_HOME
  drive-gate-scenario [name]     run golden-harness --print for one scenario
                                 (default: 01-sin-armar; partial scope)
  drive-audit-ledger             run tools/audita-ledger.sh
  drive-deploy-log               run tools/check-deploy-log.sh

state:
  .run/state.json                validated data (never sourced)
  leftover .run/env              rejected — delete the env file only and re-launch;
                                 never source it; never rm -rf its purported HOME

env:
  SAIKIT_VERIFY_STATE            override state dir (default: <skill>/.run)
  SAIKIT_VERIFY_ARTIFACTS        override artifacts dir (default: <skill>/artifacts)
EOF
}

main() {
  [ "$#" -ge 1 ] || { usage; exit 2; }
  cmd="$1"; shift
  case "$cmd" in
    launch) cmd_launch "$@" ;;
    doctor) cmd_doctor "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    cli) cmd_cli "$@" ;;
    list-features) cmd_list_features "$@" ;;
    drive) cmd_drive "$@" ;;
    drive-install-dry-run) cmd_drive_install_dry_run "$@" ;;
    drive-gate-scenario) cmd_drive_gate_scenario "$@" ;;
    drive-audit-ledger) cmd_drive_audit_ledger "$@" ;;
    drive-deploy-log) cmd_drive_deploy_log "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $cmd (try --help)" ;;
  esac
}

main "$@"
