{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "feature-map summary v1",
  "type": "object",
  "required": [
    "schema_version",
    "identity",
    "cases_requested",
    "mode",
    "provenance",
    "result",
    "exit_code",
    "reasons",
    "required_assertions",
    "observed_assertions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"const": 1},
    "identity": {
      "type": "object",
      "required": ["run_id", "attempt_id", "feature_id"],
      "properties": {
        "run_id": {"type": "string"},
        "attempt_id": {"type": "string"},
        "feature_id": {"type": "string"}
      }
    },
    "run_id": {"type": "string"},
    "attempt_id": {"type": "string"},
    "feature_id": {"type": "string"},
    "cases": {"type": "array", "items": {"type": "string"}},
    "cases_requested": {"type": "array", "items": {"type": "string"}},
    "mode": {"enum": ["sandbox", "simulated", "live"]},
    "provenance": {
      "type": "object",
      "properties": {
        "git_sha": {"type": "string"},
        "dirty": {"type": "boolean"},
        "file_hash": {"type": "string"}
      }
    },
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"},
    "result": {"enum": ["PASS", "FAIL", "unknown"]},
    "exit_code": {"enum": [0, 1, 3]},
    "reasons": {"type": "array", "items": {"type": "string"}},
    "required_assertions": {"type": "array", "items": {"type": "string"}},
    "observed_assertions": {"type": "array", "items": {"type": "string"}},
    "step_count": {"type": "integer"},
    "assertion_count": {"type": "integer"},
    "scope": {"type": "string"},
    "declared_scope": {"type": "string"},
    "scope_partial": {"type": "boolean"}
  }
}
