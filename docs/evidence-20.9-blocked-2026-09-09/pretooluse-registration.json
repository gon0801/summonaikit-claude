[
  {
    "matcher": "Bash",
    "hooks": [
      {
        "type": "command",
        "command": "rtk hook claude"
      }
    ]
  },
  {
    "matcher": "Bash",
    "hooks": [
      {
        "type": "command",
        "command": "SUMMONAIKIT_HOOK_TARGET=claude bash -c 'h=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.claude/hooks/summonaikit-harness.sh\"; [ -f \"$h\" ] || h=\"$HOME/.claude/hooks/summonaikit-harness.sh\"; /opt/homebrew/bin/bash \"$h\"'",
        "timeout": 30,
        "statusMessage": "Checking SummonAI Kit merge guard"
      }
    ]
  }
]
